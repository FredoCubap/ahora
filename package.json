{
  "name": "ahora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "app": "shell\\.venv\\Scripts\\python.exe shell\\main.py",
