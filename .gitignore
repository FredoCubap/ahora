# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Base de datos local de la app
*.db
*.db-journal
*.db-wal
*.db-shm

# Node / Vite
node_modules
dist
dist-ssr
*.local

# Salidas de PyInstaller e Inno Setup (se generan con npm run package/installer)
build/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OpenSpec se versiona en este repo, aunque la regla global de git
# (~/.config/git/ignore) lo ignora en el resto de los proyectos.
!openspec/
